{
  "name": "gtengine-js",
  "version": "0.1.0",
  "description": "TypeScript port of the Geometric Tools Engine (GTE) Mathematics library by David Eberly",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "gen:index": "node scripts/gen-index.mjs",
    "update:status": "node scripts/update-status.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "test:fast": "vitest run --reporter=dot",
    "update:verification": "node scripts/update-verification.mjs",
    "gen:verify-groups": "node scripts/gen-verify-groups.mjs"
  },
  "keywords": [
    "geometry",
    "mathematics",
    "geometric-tools",
    "gte",
    "distance",
    "intersection",
    "computational-geometry"
  ],
  "license": "BSL-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gradientspaceai/gtengine-js.git"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
